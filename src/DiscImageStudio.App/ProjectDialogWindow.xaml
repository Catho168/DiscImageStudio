<Window x:Class="DiscImageStudio.ProjectDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        Title="新建工程"
        Width="880" Height="640" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ProjectTitle="{Binding DialogTitle}" />

        <Grid Grid.Row="1" Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Auto + fixed-width content: collapsing the family column in edit mode
                         (the open project's family is fixed) leaves no dead strip behind. -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: family + template picking (create mode only). -->
                <StackPanel Grid.Column="0" Width="252"
                            Visibility="{Binding ShowTemplatesVisibility}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="盘型" />
                    <controls:SegmentedControl IsSecondSelected="{Binding IsDvd}"
                                               IsEnabled="{Binding FamilySwitchEnabled}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,20,0,6"
                               Text="模板" Visibility="{Binding ShowTemplatesVisibility}" />
                    <ListBox ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}"
                             ItemContainerStyle="{StaticResource CardListBoxItem}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding ShowTemplatesVisibility}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Star column, not a horizontal StackPanel: only a
                                         constrained width lets the title trim instead of
                                         pushing the family badge out of the column. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource RowText}"
                                                   FontWeight="Medium" />
                                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="5,1" CornerRadius="5"
                                                Background="{StaticResource Surface3Brush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FamilyLabel}"
                                                       Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CompactHint}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Collapsible spacer between the two cards; gone with the family column. -->
                <Border Grid.Column="1" Width="24" Visibility="{Binding ShowTemplatesVisibility}" />

                <!-- Right: geometry form + live annulus diagram. Edit mode keeps the fields
                     and offers saving the set into the preset catalog below. -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <WrapPanel VerticalAlignment="Top">
                                <StackPanel Width="176" Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 r0 (mm)" />
                                    <TextBox Text="{Binding InnerRadiusText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="176" Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 r1 (mm)" />
                                    <TextBox Text="{Binding OuterRadiusText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="176" Margin="0,0,16,14">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="扇区数" />
                                    <TextBox Text="{Binding SectorsText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="176" Margin="0,0,16,14"
                                            Visibility="{Binding IsDvdFieldsVisibility}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="相对一次项" />
                                    <TextBox Text="{Binding PitchLinearText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="176" Margin="0,0,16,14"
                                            Visibility="{Binding IsDvdFieldsVisibility}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="相对二次项" />
                                    <TextBox Text="{Binding PitchQuadraticText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="176" Margin="0,0,16,14"
                                            Visibility="{Binding IsDvdFieldsVisibility}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="相对三次项" />
                                    <TextBox Text="{Binding PitchCubicText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <!-- Edit mode: persist this set as a user preset (create mode picks
                                 presets from the template list instead). -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding EditModeVisibility}">
                                <Button Style="{StaticResource CompactButton}"
                                        Content="将此套参数保存为预设"
                                        Command="{Binding SaveAsPresetCommand}" />
                                <TextBlock Text="{Binding SavedPresetMessage}"
                                           Style="{StaticResource HintText}" VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                       Text="{Binding ErrorMessage}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom: name + save location. The confirm/cancel pair lives on the dialog
                 footer below, not in this card: the actions belong to the window, and their
                 right edge lines up with the cards above instead of the card's own padding. -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="工程名" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="保存位置" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="浏览…"
                                Command="{Binding BrowseSavePathCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="{Binding SaveFileNameHint}" />
                </StackPanel>
            </Border>

            <!-- Shared size group: both actions take the wider label's width, so the pair reads
                 as one control instead of two differently sized buttons. -->
            <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,0" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DialogAction" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DialogAction" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="取消"
                        Click="Cancel_Click" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
