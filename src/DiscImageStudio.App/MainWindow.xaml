<Window x:Class="DiscImageStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Disc Image Studio"
        Width="1240" Height="780" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="288" Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
                <Grid x:Name="SidebarGrid" Margin="24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="TopNavPanel" Grid.Row="0" VerticalAlignment="Top" Margin="0,24,0,0">
                        <controls:SideNavItem x:Name="NavHome" LabelText="主页" IconKind="House" />
                        <controls:SideNavGroup x:Name="NavDiscGroup" LabelText="制作盘片" IconKind="Disc">
                            <!-- Plain text rows by design: no icons next to the DVD/CD entries.
                                 In the collapsed 72px bar they show their short label instead. -->
                            <controls:SideNavItem x:Name="NavDvd" LabelText="DVD" Indent="22" LabelFontSize="15" />
                            <controls:SideNavItem x:Name="NavCd" LabelText="CD" Indent="22" LabelFontSize="15" />
                        </controls:SideNavGroup>
                        <controls:SideNavItem x:Name="NavPreview" LabelText="实时预览" IconKind="Eye" />
                        <controls:SideNavItem x:Name="NavBurn" LabelText="即时刻录" IconKind="Flame" />
                    </StackPanel>
                    <StackPanel x:Name="BottomNavPanel" Grid.Row="1" VerticalAlignment="Bottom">
                        <controls:SideNavItem x:Name="NavLog" LabelText="运行日志" IconKind="Terminal" />
                        <controls:SideNavItem x:Name="NavAbout" LabelText="关于" IconKind="Info" />
                    </StackPanel>
                    <Button x:Name="SidebarCollapseToggle" Grid.Row="2" Height="40" Margin="0,8,0,16"
                            Style="{StaticResource GhostButton}" Padding="0" Focusable="False"
                            ToolTip="收起侧边栏" Click="SidebarCollapseToggle_Click">
                        <Grid>
                            <iconPacks:PackIconLucide x:Name="CollapseLeftIcon" Kind="ChevronLeft"
                                                      Width="20" Height="20" HorizontalAlignment="Left"
                                                      Margin="12,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <iconPacks:PackIconLucide x:Name="CollapseRightIcon" Kind="ChevronRight"
                                                      Width="20" Height="20" HorizontalAlignment="Center"
                                                      Visibility="Collapsed" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ProgressBar x:Name="BusyStrip" Style="{StaticResource BusyStrip}" Grid.Row="0"
                             VerticalAlignment="Top" Visibility="Collapsed" />
                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}"
                               VerticalAlignment="Center" Margin="0,0,0,4"
                               TextTrimming="CharacterEllipsis" />
                    <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                            Content="打开输出位置" IsEnabled="{Binding OpenOutputEnabled}"
                            Command="{Binding OpenOutputCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,4" />
                </Grid>
            </Grid>
        </Border>

        <!-- Toasts: top-right, over pages and sidebar -->
        <controls:ToastHost Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,40,16,0" Panel.ZIndex="20" />

        <!-- Burn confirmation modal overlay -->
        <controls:ConfirmModal x:Name="BurnConfirmModal" Grid.Row="0" Grid.RowSpan="3"
                               Panel.ZIndex="30" />
    </Grid>
</Window>
