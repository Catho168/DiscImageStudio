<UserControl x:Class="DiscImageStudio.Views.LivePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="PanelHeading" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock" BasedOn="{StaticResource PanelHeading}">
            <Setter Property="Margin" Value="0,6,0,10" />
        </Style>
        <!-- Preview output labels shared by the disc-specific precision panels. -->
        <Style x:Key="PreviewFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
        <!-- One parameter panel per (disc type, preview mode) pair; the disc type hides a
             group, the preview mode hides the two halves inside it. -->
        <Style x:Key="CdGroup" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCdSelected}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DvdGroup" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDvdSelected}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BluRayGroup" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBluRaySelected}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadbackGroup" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCalibrationPreview}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalibrationGroup" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCalibrationPreview}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageLayout" Margin="40,24,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="PageHeading" Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{Binding HeadingText}" Style="{StaticResource H1Title}" />
        </StackPanel>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      SizeChanged="PageScroll_SizeChanged">
        <Grid x:Name="PreviewLayout">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ParameterRow" Height="*" />
                <RowDefinition x:Name="PaneGapRow" Height="0" />
                <RowDefinition x:Name="CanvasRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ParameterColumn" Width="300" />
                <ColumnDefinition x:Name="PaneGapColumn" Width="16" />
                <ColumnDefinition x:Name="CanvasColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The input switch governs the parameter panel below it, so it lives in the left
                 column but outside the card: inside, it reads as the panel's own control. Its
                 top edge lines up with the canvas card, so the two columns start together. -->
            <Grid x:Name="ParameterPane" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- The source picture is the default input, so it takes the left option and the
                     switch binds the artifact mode's inverse flag for its right-hand side. -->
                <controls:SegmentedControl x:Name="InputModeSwitch" Grid.Row="0" HorizontalAlignment="Stretch"
                                            Margin="0,0,0,16"
                                            LabelA="输入原图" LabelB="输入镜像"
                                            IsSecondSelected="{Binding IsReadbackPreview}" />

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="ParameterScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="NestedScroll_PreviewMouseWheel"
                                      controls:ScrollMaskBehavior.Enabled="True">
                            <StackPanel Margin="18,18,18,10">
                            <TextBlock Text="光盘类型" Style="{StaticResource PanelHeading}" />
                            <ComboBox SelectedIndex="{Binding SelectedDiscTypeIndex}" Margin="0,0,0,18"
                                      AutomationProperties.Name="光盘类型">
                                <ComboBoxItem Content="CD" />
                                <ComboBoxItem Content="DVD" />
                                <ComboBoxItem Content="BD（蓝光）" />
                            </ComboBox>
    
                            <!-- CD parameter groups -->
                            <StackPanel Style="{StaticResource CdGroup}">
    
                                <!-- CD read-back: the generated track is the input. -->
                                <StackPanel Style="{StaticResource ReadbackGroup}">
                                    <TextBlock Text="生成音轨" Style="{StaticResource PanelHeading}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding State.CdTrackPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Width="76"
                                                Content="浏览…" Command="{Binding BrowseCdTrackCommand}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                                               Text="可直接粘贴或浏览已生成的音轨。" />
    
                                    <TextBlock Text="盘片几何（标定）" Style="{StaticResource PanelHeading}" />
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                            <TextBox Text="{Binding State.CdInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                            <TextBox Text="{Binding State.CdOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="扇区数" />
                                            <TextBox Text="{Binding State.CdSectors, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                                               Text="校准值会同步到制作页，用于下一次生成。" />
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="逆交织" VerticalAlignment="Center"
                                                  IsChecked="{Binding State.CdInterleave}" />
                                        <controls:HelpHint Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Hint="如您在盘片制作时勾选了“启用 CD-DA 延迟交织”，则应勾选该选项。" />
                                    </StackPanel>
                                </StackPanel>
    
                                <!-- CD calibration: the source picture is the input. -->
                                <StackPanel Style="{StaticResource CalibrationGroup}">
                                    <TextBlock Text="源图片" Style="{StaticResource PanelHeading}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding State.CdImagePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Width="76"
                                                Content="浏览…" Command="{Binding BrowseCdImageCommand}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                                               Text="与盘片制作页同步，非特殊需要无需在本页重复设置。" />

                                    <!-- Image processing and disc preset mirror the production page:
                                         the projection consumes the same prepared picture and the same
                                         generation geometry, so both have to be editable here too. -->
                                    <TextBlock Text="图像处理" Style="{StaticResource PanelHeading}" />
                                    <CheckBox Content="启用图像处理（黑白抖动）" Margin="0,0,0,10"
                                              IsChecked="{Binding State.CdImageProcessingEnabled}" />
                                    <CheckBox Content="sRGB 伽马校正" Margin="0,0,0,8"
                                              IsChecked="{Binding State.CdGammaCorrectionEnabled}"
                                              IsEnabled="{Binding State.CdImageProcessingEnabled}" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                                               Text="布局完成后抖动为黑白；可选伽马校正使用线性亮度。" />
                                    <TextBlock Text="图片布局" Style="{StaticResource FieldLabel}" />
                                    <ComboBox SelectedIndex="{Binding State.CdImageProcessingModeIndex}" Margin="0,0,0,10">
                                        <ComboBoxItem Content="直接映射" />
                                        <ComboBoxItem Content="环形复制" />
                                    </ComboBox>
                                    <controls:RevealPanel IsExpanded="{Binding State.IsCdRingMode}"
                                                         IsEnabled="{Binding State.IsCdRingMode}" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内圈安全边界 (mm)" />
                                            <TextBox Text="{Binding State.CdRingInnerMargin, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,10" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外圈安全边界 (mm)" />
                                            <TextBox Text="{Binding State.CdRingOuterMargin, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,10" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="图片会复制多份并朝外环形排列。" />
                                        </StackPanel>
                                    </controls:RevealPanel>

                                    <TextBlock Text="盘片预设" Style="{StaticResource PanelHeading}" />
                                    <ComboBox ItemsSource="{Binding State.CdPresets}"
                                              SelectedItem="{Binding State.SelectedCdPreset}"
                                              Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding State.CdPresetHint}" Style="{StaticResource HintText}"
                                               Margin="0,0,0,10" />
                                    <!-- Same 12px gutter and full-width right edge as the field rows
                                         above: fixed widths left the pair short of the column. -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource BrowseButton}" Margin="0"
                                                Content="打开 JSON" Command="{Binding OpenPresetsJsonCommand}" />
                                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Margin="0"
                                                Content="重新加载" Command="{Binding ReloadPresetsCommand}" />
                                    </Grid>

                                    <TextBlock Text="生成参数" Style="{StaticResource PanelHeading}" />
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                            <TextBox Text="{Binding State.CdInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                            <TextBox Text="{Binding State.CdOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="扇区数" />
                                            <TextBox Text="{Binding State.CdSectors, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
    
                                    <TextBlock Text="实测参数" Style="{StaticResource SubHeading}" />
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                            <TextBox Text="{Binding State.CdActualInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                            <TextBox Text="{Binding State.CdActualOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="尺寸 (64–8192 px)" />
                                            <TextBox Text="{Binding State.CdPreviewSize, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="预览及导出使用此尺寸：64–8192 px" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="每扇区采样" />
                                            <TextBox Text="{Binding State.CdSamplesPerSector, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="每扇区采样数：1–2352" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                                               Text="生成参数即您在进行镜像文件生成时使用的参数，实测参数则决定了预览的读取模式，即模拟真实情况下的盘片效果。" />
                                </StackPanel>
                            </StackPanel>
    
                            <!-- DVD parameter groups -->
                            <StackPanel Style="{StaticResource DvdGroup}">
    
                                <!-- DVD read-back: the generated ISO is the input. -->
                                <StackPanel Style="{StaticResource ReadbackGroup}">
                                    <TextBlock Text="生成 ISO" Style="{StaticResource PanelHeading}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding State.DvdIsoPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Width="76"
                                                Content="浏览…" Command="{Binding BrowseDvdIsoCommand}" />
                                    </Grid>
    
                                    <TextBlock Text="盘片几何" Style="{StaticResource PanelHeading}" />
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="总扇区数" />
                                            <TextBox Text="{Binding State.DvdTotalSectors, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                            <TextBox Text="{Binding State.DvdInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                            <TextBox Text="{Binding State.DvdOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对一次项" />
                                            <TextBox Text="{Binding State.DvdPitchLinear, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对二次项" />
                                            <TextBox Text="{Binding State.DvdPitchQuadratic, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对三次项" />
                                            <TextBox Text="{Binding State.DvdPitchCubic, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding State.DvdPitchSummary}" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                                               Text="校准值将同步到制作页，用于下一次生成。" />
                                </StackPanel>
    
                                <!-- DVD calibration: the source picture is the input. -->
                                <StackPanel Style="{StaticResource CalibrationGroup}">
                                    <TextBlock Text="源图片" Style="{StaticResource PanelHeading}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding State.DvdImagePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Width="76"
                                                Content="浏览…" Command="{Binding BrowseDvdImageCommand}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                                               Text="与盘片制作页同步，非特殊需要无需在本页重复设置。" />

                                    <!-- Same two production-page controls as the CD panel above. -->
                                    <TextBlock Text="图像处理" Style="{StaticResource PanelHeading}" />
                                    <CheckBox Content="启用图像处理（黑白抖动）" Margin="0,0,0,10"
                                              IsChecked="{Binding State.DvdImageProcessingEnabled}" />
                                    <CheckBox Content="sRGB 伽马校正" Margin="0,0,0,8"
                                              IsChecked="{Binding State.DvdGammaCorrectionEnabled}"
                                              IsEnabled="{Binding State.DvdImageProcessingEnabled}" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                                               Text="布局完成后抖动为黑白；可选伽马校正使用线性亮度。" />
                                    <TextBlock Text="图片布局" Style="{StaticResource FieldLabel}" />
                                    <ComboBox SelectedIndex="{Binding State.DvdImageProcessingModeIndex}" Margin="0,0,0,10">
                                        <ComboBoxItem Content="直接映射" />
                                        <ComboBoxItem Content="环形复制" />
                                    </ComboBox>
                                    <controls:RevealPanel IsExpanded="{Binding State.IsDvdRingMode}"
                                                         IsEnabled="{Binding State.IsDvdRingMode}" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内圈安全边界 (mm)" />
                                            <TextBox Text="{Binding State.DvdRingInnerMargin, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,10" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外圈安全边界 (mm)" />
                                            <TextBox Text="{Binding State.DvdRingOuterMargin, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,10" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="图片会复制多份并朝外环形排列。" />
                                        </StackPanel>
                                    </controls:RevealPanel>

                                    <TextBlock Text="盘片预设" Style="{StaticResource PanelHeading}" />
                                    <ComboBox ItemsSource="{Binding State.DvdPresets}"
                                              SelectedItem="{Binding State.SelectedDvdPreset}"
                                              Margin="0,0,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding State.DvdPresetHint}" Style="{StaticResource HintText}"
                                               Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource BrowseButton}" Margin="0"
                                                Content="打开 JSON" Command="{Binding OpenPresetsJsonCommand}" />
                                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Margin="0"
                                                Content="重新加载" Command="{Binding ReloadPresetsCommand}" />
                                    </Grid>

                                    <TextBlock Text="生成参数" Style="{StaticResource PanelHeading}" />
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="总扇区数" />
                                            <TextBox Text="{Binding State.DvdTotalSectors, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                            <TextBox Text="{Binding State.DvdInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                            <TextBox Text="{Binding State.DvdOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对一次项" />
                                            <TextBox Text="{Binding State.DvdPitchLinear, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对二次项" />
                                            <TextBox Text="{Binding State.DvdPitchQuadratic, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对三次项" />
                                            <TextBox Text="{Binding State.DvdPitchCubic, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding State.DvdPitchSummary}" Margin="0,0,0,12" />
    
                                    <TextBlock Text="实测参数" Style="{StaticResource SubHeading}" />
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                            <TextBox Text="{Binding State.DvdActualInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                            <TextBox Text="{Binding State.DvdActualOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对一次项" />
                                            <TextBox Text="{Binding State.DvdActualPitchLinear, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对二次项" />
                                            <TextBox Text="{Binding State.DvdActualPitchQuadratic, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="相对三次项" />
                                            <TextBox Text="{Binding State.DvdActualPitchCubic, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="尺寸 (64–8192 px)" />
                                            <TextBox Text="{Binding State.DvdPreviewSize, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="预览及导出使用此尺寸：64–8192 px" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="每扇区采样" />
                                            <TextBox Text="{Binding State.DvdSamplesPerSector, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="每扇区采样数：1–2048" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                                               Text="生成参数即您在进行镜像文件生成时使用的参数，实测参数则决定了预览的读取模式，即模拟真实情况下的盘片效果。" />
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding State.DvdActualPitchSummary}" Margin="0,0,0,12" />
                                </StackPanel>
                            </StackPanel>
    
                            <!-- BD shares its source and generation geometry with the production page. -->
                            <StackPanel Style="{StaticResource BluRayGroup}">
                                <StackPanel Style="{StaticResource CalibrationGroup}">
                                    <TextBlock Text="源图片" Style="{StaticResource PanelHeading}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BluRay.ImagePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Width="76"
                                                Content="浏览…" Command="{Binding BluRay.BrowseImageCommand}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                                               Text="源图片与生成参数和蓝光制作页同步。" />
                                    <TextBlock Text="图像处理" Style="{StaticResource PanelHeading}" />
                                    <CheckBox Content="启用图像处理（黑白抖动）" Margin="0,0,0,10"
                                              IsChecked="{Binding BluRay.ImageProcessingEnabled}" />
                                    <CheckBox Content="sRGB 伽马校正" Margin="0,0,0,8"
                                              IsChecked="{Binding BluRay.GammaCorrectionEnabled}"
                                              IsEnabled="{Binding BluRay.ImageProcessingEnabled}" />
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                                               Text="抖动为黑白后映射到 3T / 6T；可选伽马校正使用线性亮度。" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource ReadbackGroup}">
                                    <TextBlock Text="生成的 BD ISO" Style="{StaticResource PanelHeading}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BluRayIsoPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Width="76"
                                                Content="浏览…" Command="{Binding BrowseBluRayIsoCommand}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,18"
                                               Text="支持读取本软件按 3T / 6T 映射生成的蓝光 ISO。" />
                                </StackPanel>

                                <TextBlock Text="盘片预设" Style="{StaticResource PanelHeading}" />
                                <ComboBox ItemsSource="{Binding BluRay.Presets}"
                                          SelectedItem="{Binding BluRay.SelectedPreset}"
                                          IsEnabled="{Binding BluRay.CanEditPresets}"
                                          DisplayMemberPath="DisplayName" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="自定义预设名称" />
                                <TextBox Text="{Binding BluRay.PresetName, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding BluRay.CanEditPresets}" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Style="{StaticResource SecondaryButton}" Content="保存预设"
                                            Command="{Binding BluRay.SavePresetCommand}" Margin="0,0,6,6" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="导入 JSON"
                                            Command="{Binding BluRay.ImportPresetCommand}" Margin="0,0,6,6" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="重载"
                                            Command="{Binding BluRay.ReloadPresetsCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <TextBlock Text="{Binding BluRay.PresetStatus}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding BluRay.PresetSummary}" Style="{StaticResource HintText}"
                                           Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="总扇区数（32 的倍数）" />
                                <TextBox Text="{Binding BluRay.TotalSectors, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,16" />

                                <StackPanel Style="{StaticResource CalibrationGroup}">
                                    <TextBlock Text="生成参数" Style="{StaticResource PanelHeading}" />
                                    <WrapPanel>
                                        <StackPanel Width="122" Margin="0,0,12,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                            <TextBox Text="{Binding BluRay.InnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Width="122" Margin="0,0,0,12">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                            <TextBox Text="{Binding BluRay.OuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <CheckBox Content="反转 3T / 6T 对应关系"
                                              IsChecked="{Binding BluRay.InvertMapping}"
                                              IsEnabled="{Binding BluRay.CanChangeMapping}" Margin="0,0,0,12" />
                                </StackPanel>

                                <TextBlock Text="实际参数" Style="{StaticResource SubHeading}" />
                                <WrapPanel>
                                    <StackPanel Width="122" Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                        <TextBox Text="{Binding BluRayActualInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="122" Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                        <TextBox Text="{Binding BluRayActualOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="122" Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="起始角 (°)" />
                                        <TextBox Text="{Binding BluRayActualStartAngle, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                                           Text="选择预设时，实际参数先同步为预设值，再按测量结果微调。" />
                                <StackPanel Style="{StaticResource CalibrationGroup}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="预览尺寸 (64–8192 px)" />
                                    <TextBox Text="{Binding BluRayPreviewSize, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="预览及导出使用此尺寸：64–8192 px"
                                             Margin="0,0,0,14" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                                           Text="预览用黑白表示 3T / 6T 图案分布，盘面实际明暗需以实盘为准。" />
                            </StackPanel>

                        </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,16,16">
                            <Button x:Name="RefreshPreviewButton" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0"
                                    Content="刷新预览" Command="{Binding RefreshCommand}" Margin="18,12" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="PreviewCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0"
                    SizeChanged="PreviewCard_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="16,16,0,0">
                        <Grid Margin="16,0,100,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PreviewTitle" Text="{Binding ResultPreviewTitle}" Style="{StaticResource CardTitle}"
                                       FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ResultPreviewTitle}" />
                            <!-- Reserve action space in the grid itself; a long filename must not
                                 grow the title row or push the action buttons beyond the card. -->
                            <TextBlock x:Name="PreviewPath" Grid.Row="1" Text="{Binding ResultPreviewPath}" Style="{StaticResource HintText}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" LineHeight="14"
                                       ToolTip="{Binding ResultPreviewPath}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <Canvas x:Name="PreviewViewport" Margin="18" ClipToBounds="True" Background="Transparent"
                                SizeChanged="PreviewViewport_SizeChanged" PreviewMouseWheel="PreviewViewport_MouseWheel"
                                MouseLeftButtonDown="PreviewViewport_MouseLeftButtonDown"
                                MouseLeftButtonUp="PreviewViewport_MouseLeftButtonUp"
                                MouseMove="PreviewViewport_MouseMove" LostMouseCapture="PreviewViewport_LostMouseCapture"
                                ToolTip="滚轮缩放 · 拖动平移 · 双击适应窗口">
                        <Image x:Name="PreviewImage" Source="{Binding ResultImage}" Stretch="Fill"
                               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PreviewScale" />
                                    <TranslateTransform x:Name="PreviewTranslation" />
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResultImage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        </Canvas>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResultImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <iconPacks:PackIconLucide Kind="Disc" Width="48" Height="48" HorizontalAlignment="Center"
                                                      Foreground="{StaticResource Surface3Brush}" />
                            <TextBlock Text="{Binding ResultPreviewPlaceholderText}" Style="{StaticResource HintText}"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="PreviewFooter" Grid.Row="2" Margin="16,3,10,3" MinHeight="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewStatus" Text="{Binding StatusText}" Style="{StaticResource HintText}"
                                   Margin="0,0,8,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}" />
                        <StackPanel x:Name="ZoomControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding HasResultImage}">
                            <Button x:Name="FitPreviewButton" Style="{StaticResource GhostButton}" Content="适应窗口" Height="28" Padding="8,0"
                                    Click="FitButton_Click" ToolTip="显示完整图片（双击画布）" />
                            <Button x:Name="ActualPixelsButton" Style="{StaticResource GhostButton}" Content="1:1" Height="28" Padding="8,0"
                                    Click="ActualPixelsButton_Click" ToolTip="一个图片像素对应一个屏幕像素" />
                            <TextBlock x:Name="ZoomLabel" Text="—" MinWidth="46" TextAlignment="Right"
                                       Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Title-bar actions. The eye reveals the read-back precision panel, the download
                         glyph exports the current preview next to its input. The panel is an in-card
                         overlay rather than a Popup so it shares one hover region with its glyph (no
                         timers, no second window), and the two glyphs sit in their own cells so hovering
                         the download never opens the panel. The calibration panel carries its own size
                         and sampling fields, so the eye is read-back only. -->
                    <!-- Canvas contributes no desired width/height: opening the precision panel
                         must not enlarge the card or its surrounding star-sized rows. -->
                    <Canvas Grid.Row="0" Grid.RowSpan="3" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Canvas.Right="16" Canvas.Top="6">
                        <Grid x:Name="PrecisionHost" VerticalAlignment="Top" Background="Transparent">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalibrationPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- The panel sets the host's width, so the glyph stays pinned to the
                                 host's right edge instead of stretching to the widened row. -->
                            <Button x:Name="PrecisionButton" Style="{StaticResource GhostButton}"
                                    Width="32" Height="32" Padding="0"
                                    HorizontalAlignment="Right" AutomationProperties.Name="预览精度">
                                <iconPacks:PackIconLucide Kind="Eye" Width="18" Height="18" />
                            </Button>
                            <Border x:Name="PrecisionPanel" Grid.Row="1" Width="248" Margin="0,6,0,0" Padding="0"
                                    Background="{StaticResource Surface1Brush}"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=PrecisionHost}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PrecisionHost}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="6" BlurRadius="18" Opacity="0.45" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer x:Name="PrecisionScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="NestedScroll_PreviewMouseWheel">
                                <StackPanel Margin="16">
                                    <TextBlock Text="预览精度" Style="{StaticResource PanelHeading}" />
                                    <!-- CD preview output -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCdSelected}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource PreviewFieldLabel}" Text="尺寸 (64–8192 px)" />
                                        <TextBox Text="{Binding State.CdPreviewSize, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="预览及导出使用此尺寸：64–8192 px" />
                                        <TextBlock Style="{StaticResource PreviewFieldLabel}" Text="每扇区采样" />
                                        <TextBox Text="{Binding State.CdSamplesPerSector, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="每扇区采样数：1–2352" />
                                    </StackPanel>
                                    <!-- DVD preview output -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDvdSelected}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource PreviewFieldLabel}" Text="尺寸 (64–8192 px)" />
                                        <TextBox Text="{Binding State.DvdPreviewSize, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="预览及导出使用此尺寸：64–8192 px" />
                                        <TextBlock Style="{StaticResource PreviewFieldLabel}" Text="每扇区采样" />
                                        <TextBox Text="{Binding State.DvdSamplesPerSector, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="每扇区采样数：1–2048" />
                                    </StackPanel>
                                    <!-- BD preview output -->
                                    <StackPanel Style="{StaticResource BluRayGroup}">
                                        <TextBlock Style="{StaticResource PreviewFieldLabel}" Text="尺寸 (64–8192 px)" />
                                        <TextBox Text="{Binding BluRayPreviewSize, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="预览及导出使用此尺寸：64–8192 px" />
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <!-- No flyout here: a press writes the current preview next to its input. -->
                        <Button x:Name="DownloadButton" Style="{StaticResource GhostButton}" Width="32" Height="32"
                                Padding="0" Focusable="False" Margin="6,0,0,0" VerticalAlignment="Top"
                                Command="{Binding DownloadPreviewCommand}"
                                AutomationProperties.Name="导出预览"
                                ToolTipService.InitialShowDelay="150"
                                ToolTip="导出当前预览图到输入来源所在文件夹">
                            <iconPacks:PackIconLucide Kind="Download" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
