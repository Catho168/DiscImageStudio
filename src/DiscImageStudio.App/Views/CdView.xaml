<UserControl x:Class="DiscImageStudio.Views.CdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls">
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel MaxWidth="800" Margin="40,24,40,40">
            <TextBlock Style="{StaticResource H1Title}" Text="CD 音轨盘" Margin="0,0,0,24" />

            <controls:SectionCard Header="文件" IconKind="Folder" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="源图片" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding State.CdImagePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="浏览…"
                                Command="{Binding BrowseImageCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="图片处理模式" />
                    <ComboBox SelectedIndex="{Binding State.CdImageProcessingModeIndex}" Margin="0,0,0,12">
                        <ComboBoxItem Content="原图直接映射" />
                        <ComboBoxItem Content="环形复制（自动份数）" />
                    </ComboBox>
                    <controls:RevealPanel IsExpanded="{Binding State.IsCdRingMode}"
                                         IsEnabled="{Binding State.IsCdRingMode}" Margin="0,0,0,4">
                        <WrapPanel>
                            <StackPanel Width="190" Margin="0,0,16,10">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="内圈安全边界 (mm)" />
                                <TextBox Text="{Binding State.CdRingInnerMargin, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="190" Margin="0,0,16,10">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="外圈安全边界 (mm)" />
                                <TextBox Text="{Binding State.CdRingOuterMargin, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Width="360" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                       Margin="0,0,0,10"
                                       Text="图片会复制多份并朝外环形排列；空间不足时自动等比缩小，保证不变形、不裁切、不重叠。" />
                        </WrapPanel>
                    </controls:RevealPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="输出音轨 (.wav / .raw)" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding State.CdOutputPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="选择…"
                                Command="{Binding BrowseOutputCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="推荐 WAV，同时生成 CUE；ImgBurn 打开 CUE，cdrecord 直接刻录 WAV。RAW 保留旧格式。" />
                </StackPanel>
            </controls:SectionCard>

            <controls:SectionCard Header="生成几何" IconKind="Disc3" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="盘片预设" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding State.CdPresets}"
                                  SelectedItem="{Binding State.SelectedCdPreset}"
                                  DisplayMemberPath="DisplayName" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Width="104"
                                Content="打开 JSON" Command="{Binding OpenPresetsJsonCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Width="96"
                                Content="重新加载" Command="{Binding ReloadPresetsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding State.CdPresetHint}" Style="{StaticResource HintText}"
                               Margin="0,0,0,14" />
                    <WrapPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 r0 (mm)" />
                            <TextBox Text="{Binding State.CdInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 r1 (mm)" />
                            <TextBox Text="{Binding State.CdOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="扇区数" />
                            <TextBox Text="{Binding State.CdSectors, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="线速度 (mm/s)" />
                            <TextBox Text="{Binding State.CdVelocity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="起始角 theta0 (°)" />
                            <TextBox Text="{Binding State.CdStartAngle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="图片外半径 (mm)" />
                            <TextBox Text="{Binding State.CdImageOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox Content="启用 CD-DA 延迟交织"
                              IsChecked="{Binding State.CdInterleave}" />
                </StackPanel>
            </controls:SectionCard>

            <controls:SectionCard Header="实测几何与预览" IconKind="Eye" Margin="0,0,0,24">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="实测内半径 (mm)" />
                            <TextBox Text="{Binding State.CdActualInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="实测外半径 (mm)" />
                            <TextBox Text="{Binding State.CdActualOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="实测线速度 (mm/s)" />
                            <TextBox Text="{Binding State.CdActualVelocity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="实测起始角 (°)" />
                            <TextBox Text="{Binding State.CdActualStartAngle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="预览尺寸" />
                            <TextBox Text="{Binding State.CdPreviewSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="每扇区采样" />
                            <TextBox Text="{Binding State.CdSamplesPerSector, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="预览 PNG" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding State.CdPreviewPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="选择…"
                                Command="{Binding BrowsePreviewCommand}" />
                    </Grid>
                </StackPanel>
            </controls:SectionCard>

            <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="生成 CD 音轨"
                        Command="{Binding GenerateCommand}" Margin="0,0,12,10" />
                <Button Style="{StaticResource SecondaryButton}" Content="预览几何校准"
                        Command="{Binding PreviewWarpCommand}" Margin="0,0,12,10" />
                <Button Style="{StaticResource SecondaryButton}" Content="预览已有音轨"
                        Command="{Binding PreviewTrackCommand}" Margin="0,0,0,10" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
