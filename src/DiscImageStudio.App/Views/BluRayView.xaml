<UserControl x:Class="DiscImageStudio.Views.BluRayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls">
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel MaxWidth="800" Margin="40,24,40,40">
            <TextBlock Style="{StaticResource H1Title}" Text="蓝光模式" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource HintText}" Text="BD-R · ISO/IEC 30190:2021" Margin="0,0,0,20" />

            <Border Style="{StaticResource CardStyle}" Padding="18,14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding MappingHeading}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding MappingStatus}" Style="{StaticResource HintText}" />
                    <CheckBox Content="反转 3T / 6T 对应关系" IsChecked="{Binding InvertMapping}"
                              IsEnabled="{Binding CanChangeMapping}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <controls:SectionCard Header="盘片参数" IconKind="Disc" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="盘片预设" />
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              IsEnabled="{Binding CanEditPresets}"
                              DisplayMemberPath="DisplayName" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="自定义预设名称" />
                    <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditPresets}" Margin="0,0,0,10" />
                    <WrapPanel Margin="0,0,0,6">
                        <Button Style="{StaticResource SecondaryButton}" Content="保存为新预设"
                                Command="{Binding SavePresetCommand}" Margin="0,0,8,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="导入参数 JSON"
                                Command="{Binding ImportPresetCommand}" Margin="0,0,8,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="重新加载预设"
                                Command="{Binding ReloadPresetsCommand}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding PresetStatus}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PresetSummary}" Style="{StaticResource HintText}" Margin="0,0,0,12" />
                    <WrapPanel>
                        <StackPanel Width="240" Margin="0,0,16,12">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="总扇区数（32 的倍数）" />
                            <TextBox Text="{Binding TotalSectors, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,12">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="数据区内半径 (mm)" />
                            <TextBox Text="{Binding InnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,16,12">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="数据区外半径 (mm)" />
                            <TextBox Text="{Binding OuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding GeometryStatus}" Style="{StaticResource HintText}" />
                    <TextBlock Text="几何计算、ISO 镜像和流式刻录共用这里的总扇区数；文件系统和内圈文件也包含在总数内。"
                               Style="{StaticResource HintText}" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="导出参数 JSON"
                                Command="{Binding ExportParametersCommand}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="辅助标定"
                                Command="{Binding OpenCalibrationCommand}" />
                    </WrapPanel>
                </StackPanel>
            </controls:SectionCard>

            <controls:SectionCard Header="内圈包含文件（可选）" IconKind="Folder" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="留空时整个用户数据区用于绘图，无文件系统；选择文件夹后才使用 UDF，支持大于 4 GB 的单文件，图案位于文件之后及盘尾备份元数据之前。"
                               Style="{StaticResource HintText}" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="文件夹" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DataDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="浏览…" Command="{Binding BrowseDataDirectoryCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Content="清空" Command="{Binding ClearDataDirectoryCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="光盘卷标" />
                    <TextBox Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding LayoutStatus}" Style="{StaticResource HintText}" Margin="0,12,0,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="计算文件布局"
                            Command="{Binding CheckLayoutCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </controls:SectionCard>

            <controls:SectionCard Header="源图片与布局" IconKind="Image" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="源图片" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="浏览…"
                                Command="{Binding BrowseImageCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="图像处理" />
                    <CheckBox Content="启用图像处理（黑白抖动）" Margin="0,0,0,10"
                              IsChecked="{Binding ImageProcessingEnabled}" />
                    <CheckBox Content="sRGB 伽马校正" Margin="0,0,0,8"
                              IsChecked="{Binding GammaCorrectionEnabled}"
                              IsEnabled="{Binding ImageProcessingEnabled}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                               Text="开启后，通过蛇形 Floyd–Steinberg 抖动转换为黑白，再映射到 3T / 6T；可选伽马校正会在线性亮度下分配黑白像素。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="200" Height="200" CornerRadius="12" Background="{StaticResource Surface2Brush}">
                            <Grid Width="180" Height="180">
                                <Ellipse Stroke="{StaticResource DividerBrush}" StrokeThickness="1" />
                                <Grid Clip="{Binding PreviewClip}">
                                    <Rectangle Fill="{StaticResource Surface3Brush}" />
                                    <Image Source="{Binding SourcePreview}" Stretch="Uniform" />
                                </Grid>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock Text="源图几何布局" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <TextBlock Text="显示源图在整个数据区中的位置。不附带文件时首尾均用于绘图；附带文件时排除文件与 UDF 元数据。此处不模拟 3T / 6T 的盘面明暗。"
                                       Style="{StaticResource HintText}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource HintText}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="实时预览…"
                                    Command="{Binding OpenLivePreviewCommand}" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="ISO 镜像输出 (.iso)" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ImageOutputPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="选择…"
                                Command="{Binding BrowseImageOutputCommand}" />
                    </Grid>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="生成蓝光 ISO"
                                Command="{Binding GenerateImageCommand}" Margin="0,0,12,0"
                                ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MappingStatus}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="取消生成"
                                Command="{Binding CancelImageCommand}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="流式刻录…"
                                Command="{Binding OpenBurnCommand}" />
                    </WrapPanel>
                </StackPanel>
            </controls:SectionCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
