<UserControl x:Class="DiscImageStudio.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <ScrollViewer Margin="40,28,40,32" controls:ScrollMaskBehavior.Enabled="True">
        <!-- MaxWidth alone centers this column: Stretch + MaxWidth arranges it at 840 and
             WPF centers the capped element, so the sections span the full page column. -->
        <StackPanel MaxWidth="840">
            <TextBlock Text="欢迎使用 Disc Image Studio。" Style="{StaticResource H1Title}" />

            <!-- Action bar: disc family on the left, the two entry actions on the right.
                 Replaces the old left rail, so the whole page reads top to bottom. -->
            <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:SegmentedControl Width="200" VerticalAlignment="Center"
                                               IsSecondSelected="{Binding IsDvdSelected}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="打开预设 JSON"
                                Height="40" Padding="14,0" FontSize="13" VerticalAlignment="Center"
                                Foreground="{StaticResource TextMutedBrush}"
                                Command="{Binding OpenPresetsJsonCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="打开"
                                Height="40" Padding="22,0" Margin="10,0,0,0"
                                Command="{Binding OpenCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="新建"
                                Height="40" Padding="26,0" Margin="10,0,0,0"
                                Command="{Binding NewCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:SectionCard Header="快速创建" Margin="0,20,0,0">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:CenteringWrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Width="146" Height="132" Margin="4"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.CreateTileCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    ToolTip="{Binding ToolTipText}">
                                <StackPanel VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="{Binding Icon}" Width="30" Height="30"
                                                              HorizontalAlignment="Center"
                                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                               Height="36" Margin="0,10,0,0" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Caption}" FontSize="12" Height="20"
                                               Margin="0,4,0,0" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SectionCard>

            <!-- No recents means no section: an empty "最近使用项" card is noise on first run. -->
            <controls:SectionCard Header="最近使用项" Margin="0,20,0,0">
                <controls:SectionCard.Style>
                    <Style TargetType="controls:SectionCard">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecents}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:SectionCard.Style>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Recents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:CenteringWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButton}" Width="188" Margin="4"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.OpenRecentCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        ToolTip="{Binding ToolTipText}">
                                    <StackPanel>
                                        <Border Height="106" CornerRadius="12,12,0,0"
                                                Background="{StaticResource Surface2Brush}">
                                            <Grid>
                                                <!-- Thumbnail paints through the border brush so the
                                                     rounded corners clip it; the glyph shows when the
                                                     source picture cannot be decoded. -->
                                                <Border CornerRadius="12,12,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                    Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                                <iconPacks:PackIconLucide Kind="FileImage" Width="32" Height="32"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{StaticResource Surface3Brush}">
                                                    <iconPacks:PackIconLucide.Style>
                                                        <Style TargetType="iconPacks:PackIconLucide">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconLucide.Style>
                                                </iconPacks:PackIconLucide>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Margin="8" Padding="6,2" CornerRadius="6"
                                                        Background="#CC121212"
                                                        BorderBrush="{StaticResource DividerBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding FamilyLabel}" FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="12,10,12,12">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconLucide Kind="Folder" Width="13" Height="13"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding LocationText}" FontSize="12"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Content="清空" Height="32" Padding="12,0"
                            FontSize="13" HorizontalAlignment="Right" Margin="0,0,0,0"
                            Foreground="{StaticResource TextMutedBrush}"
                            Command="{Binding ClearRecentsCommand}" />
                </StackPanel>
            </controls:SectionCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
