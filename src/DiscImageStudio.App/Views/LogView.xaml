<UserControl x:Class="DiscImageStudio.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,24,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource H1Title}" Text="运行日志" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,8,0,0"
                           Text="仅供开发与调试使用。" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Margin="0,0,10,0"
                        Content="打开输出位置" Command="{Binding OpenOutputCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0"
                        Content="清空显示" Command="{Binding ClearDisplayCommand}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <TextBox x:Name="LogTextBox" Style="{StaticResource BareTextBox}" IsReadOnly="True" AcceptsReturn="True"
                     VerticalAlignment="Stretch"
                     FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Background="Transparent" BorderThickness="0"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Padding="16" />
        </Border>
    </Grid>
</UserControl>
