<UserControl x:Class="DiscImageStudio.Controls.SideNavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Border x:Name="Root" Height="48" CornerRadius="12" Background="Transparent" Cursor="Hand"
            SnapsToDevicePixels="True">
        <ToolTipService.ToolTip>
            <ToolTip x:Name="NavToolTip" Visibility="Collapsed" Content="{Binding LabelText}" />
        </ToolTipService.ToolTip>
        <StackPanel x:Name="ItemContent" Orientation="Horizontal" Margin="12,0"
                    VerticalAlignment="Center">
            <iconPacks:PackIconLucide x:Name="Icon" Width="22" Height="22" Visibility="Collapsed" />
            <TextBlock x:Name="LabelTextBlock" Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="16" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
