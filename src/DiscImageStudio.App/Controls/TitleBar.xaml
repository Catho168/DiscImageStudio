<UserControl x:Class="DiscImageStudio.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Height="32" Background="{StaticResource BackgroundBrush}">
        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
            <Image Source="{StaticResource AppIconSource}" Width="16" Height="16" Margin="0,0,8,0" />
            <TextBlock Text="Disc Image Studio" FontSize="12"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Width="46" Height="32" Focusable="False" Click="Minimize_Click"
                    ToolTip="最小化">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hot" Background="Transparent">
                            <Path Data="{StaticResource WinMinimizeIcon}" Stroke="White" StrokeThickness="1"
                                  Width="10" Height="1" Stretch="None" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{StaticResource TitleBarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{StaticResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="MaximizeButton" Width="46" Height="32" Focusable="False" Click="Maximize_Click"
                    ToolTip="最大化">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hot" Background="Transparent">
                            <Grid Width="10" Height="10">
                                <Path x:Name="MaximizeGlyph" Data="{StaticResource WinMaximizeIcon}" Stroke="White"
                                      StrokeThickness="1" Stretch="None" />
                                <Path x:Name="RestoreGlyph" Data="{StaticResource WinRestoreIcon}" Stroke="White"
                                      StrokeThickness="1" Stretch="None" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{StaticResource TitleBarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{StaticResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CloseButton" Width="46" Height="32" Focusable="False" Click="Close_Click" ToolTip="关闭">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hot" Background="Transparent">
                            <Path Data="{StaticResource WinCloseIcon}" Stroke="White" StrokeThickness="1"
                                  Width="10" Height="10" Stretch="None" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="#E6C42B1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{StaticResource CloseHotBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
