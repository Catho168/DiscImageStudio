<UserControl x:Class="DiscImageStudio.Controls.ConfirmModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Focusable="False">
    <Grid x:Name="Root" Visibility="Collapsed">
        <Rectangle x:Name="Backdrop" Fill="{StaticResource BackdropBrush}" />
        <Border x:Name="DialogCard" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                CornerRadius="16" Padding="24" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="10" BlurRadius="32" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="TriangleAlert" Width="24" Height="24"
                                              Foreground="{StaticResource DangerBrush}" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource CardTitle}" FontSize="17"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                            Content="取消" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Grid.Column="2" Style="{StaticResource DangerButton}"
                            Content="确认刻录" Click="Confirm_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
